root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust and TOML use 4-space indentation
[*.{rs,toml}]
indent_size = 4

# Markdown: preserve trailing spaces (can be intentional line breaks)
[*.md]
trim_trailing_whitespace = false
